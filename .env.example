# Copy this file to .env and fill in your own values. Never commit .env.

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# True for local development, False in production
DJANGO_DEBUG=True

# Comma-separated host names allowed to serve the app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Needed in production behind HTTPS, e.g. https://plf.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Where uploaded Word files are stored (defaults to ./media)
# DJANGO_MEDIA_ROOT=

# Set to False only if you run production mode without HTTPS (local testing)
# DJANGO_SECURE_COOKIES=True

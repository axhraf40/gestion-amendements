# Copy this file to .env and fill in your own values. Never commit .env.

# ---------- Django ----------
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# True for local development, False in production
DJANGO_DEBUG=True

# Comma-separated host names allowed to serve the app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Needed in production behind HTTPS, e.g. https://plf.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Where uploaded Word files are stored (defaults to ./media)
# DJANGO_MEDIA_ROOT=

# Set to False only if you run production mode without HTTPS (local testing)
# DJANGO_SECURE_COOKIES=True

# ---------- AI field detection ----------
# Provider: huggingface | groq | openrouter | ollama | none
AI_PROVIDER=huggingface

# Your own key (never commit it):
#   Hugging Face: https://huggingface.co/settings/tokens  (fine-grained, "Make calls to Inference Providers")
#   Groq:         https://console.groq.com/keys
#   Ollama:       leave empty
AI_API_KEY=

# Optional: model (otherwise the provider default)
#   huggingface: Qwen/Qwen2.5-72B-Instruct · groq: llama-3.3-70b-versatile · ollama: qwen2.5:7b
AI_MODEL=

# Optional (Hugging Face): inference provider used by InferenceClient (auto by default)
# AI_HF_PROVIDER=auto

# Optional: request timeout in seconds
# AI_TIMEOUT=40

# Optional: LibreOffice executable if it is not in the default location / PATH
# SOFFICE_PATH=
